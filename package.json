{
  "name": "opencode-preview",
  "version": "0.13.0-v2.0.0",
  "description": "OpenCode plugin for Markdown and DrawIO preview with live reload (self-maintained V2 port)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./standalone": "./src/server.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/server.ts",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "preview",
    "markdown",
    "drawio",
    "live-reload",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TurboBinCN/opencode-preview.git"
  },
  "homepage": "https://github.com/TurboBinCN/opencode-preview#readme",
  "bugs": {
    "url": "https://github.com/TurboBinCN/opencode-preview/issues"
  },
  "license": "MIT",
  "dependencies": {
    "marked": "^15.0.12",
    "ws": "^8"
  },
  "devDependencies": {
    "@opencode/plugin": "latest",
    "@types/bun": "latest",
    "@types/ws": "^8"
  }
}